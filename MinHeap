// Min Heap
// Time Complexity: O(log n)
// Space Complexity: O(n)

public class MinHeap {
    private int[]heap;
    private int size;

    public MinHeap(int capacity){
        heap = new int[capacity];
        size = 0;
    }
    public void insert(int val) {
        heap[size] = val;
        siftUp(size);
        size++;
    }
    public int extractMin(){
        int min = heap[0];
        heap[0] = heap[size - 1];
        size--;
        siftDown(0);
        return min;
    }
    private void siftUp(int i) {
        while (i > 0) {
            int parent = (i - 1) / 2;
            if (heap[i] < heap[parent]) {
                int tmp = heap[i];
                heap[i] = heap[parent];
                heap[parent] = tmp;
                i = parent;
            } else {
                break;
            }
        }
    }
    private void siftDown(int i) {
        while (true) {
            int smallest = i;
            int left = 2 * i + 1;
            int right = 2 * i + 2;
            if (left < size && heap[left] < heap[smallest]) {
                smallest = left;
            }
            if (right < size && heap[right] < heap[smallest]) {
                smallest = right;
            }
            if (smallest != i) {
                int tmp = heap[i];
                heap[i] = heap[smallest];
                heap[smallest] = tmp;
                i = smallest;
            } else {
                break;
            }
        }
    }
    public static int[] heapSort(int[] arr) {
        MinHeap h = new MinHeap(arr.length);
        for (int val : arr) {
            h.insert(val);
        }
        int[] sorted = new int[arr.length];
        for (int i = 0; i < arr.length; i++) {
            sorted[i] = h.extractMin();
        }
        return sorted;
    }
    //test case
    //test case
    public static void main(String[] args) {
        int[] array1 = {6, 8, 1, 5, 3, 9, 7};
        int[] sorted1 =heapSort(array1);
        System.out.println(java.util.Arrays.toString(sorted1));

        int[] array2 = {142, 86, 11, 34, 53, 43};
        int[] sorted2 =heapSort(array2);
        System.out.println(java.util.Arrays.toString(sorted2));
    }
}
